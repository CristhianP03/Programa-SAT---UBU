# Plantilla de variables de entorno - COPIAR A .env Y EDITAR
# cp .env.example .env
# NUNCA subir .env real a GitHub (ya ignorado en .gitignore)

DB_USERNAME=postgres
DB_PASSWORD=CHANGEME
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_16_chars
APP_BASE_URL=http://localhost:8080

# --- Usuarios del sistema - roles ---
# ADMIN: administrador general (ve todas las areas, 1 usuario)
# ENCARGADO: encargado por area (varios usuarios: Trabajo Social, Psicologia, Danza, Musica, Deportes)
# Cada usuario tiene: usuario (login) + correo + contrasena (hash BCrypt)

# Instrucciones correo Gmail:
# 1. Activa verificacion en 2 pasos en myaccount.google.com
# 2. Seguridad > Contrasenas de aplicaciones > Generar nueva (16 chars sin espacios)
# 3. Pega aqui sin espacios: ej. abcd efgh ijkl mnop -> abcdefghijklmnop
